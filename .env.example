# English: copy to .env.local for `npm run dev`. On a host, set the same names in the dashboard.
# Español: copiá esto a .env.local para `npm run dev`. En un host, cargá los mismos nombres en el panel.
# Leave these empty in the example. Put real values only in the host or in .env.local.
# Dejá estos valores vacíos en el ejemplo. Los valores reales van solo en el host o en .env.local.

ACCESS_CODE=
SESSION_SECRET=
BOT_API_TOKEN=

# Free SQLite. Required on Vercel Hobby and Netlify so data survives a restart.
# SQLite gratuito. Hace falta en Vercel Hobby y Netlify para que los datos sobrevivan un reinicio.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Optional. Used only by Refresh on Goals. Omit them to keep those goals manual.
# Opcional. Lo usa Actualizar en Metas. Si no están, esas metas quedan manuales.
# WOO_URL=
# WOO_KEY=
# WOO_SECRET=
# WOO_PRODUCT_MATCH=
# GUMROAD_TOKEN=
# VIDEO_GOAL_PROJECT=
