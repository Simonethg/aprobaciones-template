# Copy this file to .env.local for `npm run dev`. On a host, set the same names in its dashboard.
# Leave the values empty here. Real values belong only in the host settings or in .env.local.

ACCESS_CODE=
SESSION_SECRET=
BOT_API_TOKEN=

# Free SQLite. Required on Vercel Hobby and Netlify so data survives a restart.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Optional. Only used by Refresh on the Goals screen. Leave them out to keep those goals manual.
# WOO_URL=
# WOO_KEY=
# WOO_SECRET=
# WOO_PRODUCT_MATCH=
# GUMROAD_TOKEN=
# VIDEO_GOAL_PROJECT=
